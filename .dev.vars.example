# Brain: set GEMINI_API_KEY (free tier) to use Gemini, otherwise OPENAI_API_KEY is used.
# GEMINI_API_KEY=...
# Optional: GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=...
# Optional: a Bangla voice from the ElevenLabs voice library. Without it a default premade voice speaks Bangla.
# ELEVENLABS_VOICE_ID=...
# Optional: ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ADMIN_ACCESS_KEY=choose-a-long-random-key
