{
  "name": "dentis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/**/*.test.js\"",
    "db:init:local": "wrangler d1 migrations apply dentis --local",
    "db:samples:local": "wrangler d1 execute dentis --local --file=seed/sample_calls.sql",
    "db:samples:remote": "wrangler d1 execute dentis --remote --file=seed/sample_calls.sql",
    "db:init:remote": "wrangler d1 migrations apply dentis --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
